# Copy cloud fields into QuantaCore's server-only .env, then restart Quanta.
# Deploy and secure your own OpenDots app and computer supervisor first.
OPENDOTS_CLOUD_URL=
OPENDOTS_CLOUD_OWNER_TOKEN=

# OpenDots itself uses C:\QuantaOpenDots\.env. Do not use VITE_ for secrets.
# It requires its own INTELLIGENCE_API_KEY, OPENAI_API_KEY and model settings.
# Before enabling Docker computers, generate separate high-entropy values for:
# COMPUTER_SUPERVISOR_TOKEN=
# COMPUTER_TOKEN=
# COMPUTER_NAMESPACE=quanta-opendots
