# ============================================================
# OpenNoesis — Local Environment
# ============================================================

# ─── OpenRouter (Primary — all models via one key) ────────
OPENROUTER_API_KEY=                        # sk-or-v1-...  ← paste your key here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── Model Selection ──────────────────────────────────────
# Primary: fast, cheap, vision-capable (entity extraction, video coding, memory)
PRIMARY_MODEL=google/gemini-2.0-flash-001

# Reasoning: heavier model for complex agent tasks, RCB orchestration
REASONING_MODEL=google/gemini-2.5-pro-preview

# Vision: for Graph Video Coding frame analysis (same as primary — gemini has vision)
VISION_MODEL=google/gemini-2.0-flash-001

# Fallback options (just change the model strings to switch):
#   anthropic/claude-3.5-sonnet      — Best quality, vision support
#   anthropic/claude-3-haiku          — Fast + cheap alternative
#   openai/gpt-4o                     — Standard, vision support
#   openai/gpt-4o-mini                — Cheapest OpenAI option
#   meta-llama/llama-3.3-70b-instruct — Open-weights, fast

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Memgraph ─────────────────────────────────────────────
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# ─── Memory / Graph LLM (maps to model selection above) ───
GRAPH_LLM=google/gemini-2.0-flash-001
LONG_TERM_MEMORY_LLM=google/gemini-2.0-flash-001
EMBEDDING_MODEL=openai/text-embedding-3-small   # OpenRouter passes through embeddings

# ─── App ──────────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development
WANDB_DISABLED=true
