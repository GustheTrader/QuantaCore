# ============================================================
# OpenNoesis Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ─── LLM API Keys ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ─── OpenRouter demo route (server-only; never expose this key in browser code) ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Dynamic OpenRouter route that selects an available free model.
OPENROUTER_MODEL=openrouter/free

# ─── Public Supabase browser client (also set as Vercel build variables) ──
# Supabase project URL and anon/publishable key. The anon key is public by design;
# never use a service-role key in either variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Supabase Edge Function secrets (set in Supabase Dashboard, not Vercel) ──
# These values are for supabase/functions/.env during local function development.
# Set the production copies in Supabase Dashboard > Edge Functions > Secrets.
# Copy OPENROUTER_API_KEY and OPENROUTER_MODEL from the section above to
# supabase/functions/.env when running the function locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QUANTA_ALLOWED_ORIGINS=https://quanta-core.vercel.app

# ─── Memory Server Config ────────────────────────────────────
LONG_TERM_MEMORY_LLM=gpt-4o-mini       # LLM for memory extraction/summarization
EMBEDDING_MODEL=text-embedding-3-small  # Embedding model for vector search
LTM_LLM=gpt-4o-mini

# ─── Sovereign AIOS memory adapters (local runtime only) ──────
# Hindsight is long-term fact/observation retrieval; Honcho is per-thread session memory.
# Both run locally by default. Never place these secrets in VITE_* variables.
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=openrouter/free
HINDSIGHT_API_LLM_BASE_URL=https://openrouter.ai/api/v1
HONCHO_BASE_URL=http://127.0.0.1:8000
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=quanta-core

# ─── Redis Config ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Memgraph Config ─────────────────────────────────────────
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USERNAME=          # leave empty for default
MEMGRAPH_PASSWORD=          # leave empty for default

# ─── NOESIS Engine Config ────────────────────────────────────
NOESIS_MODEL_ID=openai-community/gpt2   # Base HuggingFace model
NOESIS_C_THOUGHT=2                       # Number of continuous thought tokens per step
NOESIS_SAVE_PATH=./checkpoints           # Where to save model checkpoints
WANDB_PROJECT=opennoesis                 # Weights & Biases project name
WANDB_DISABLED=true                      # Set false to enable wandb logging

# ─── LangGraph / Orchestration ───────────────────────────────
LANGGRAPH_CHECKPOINT_BACKEND=redis       # Use Redis for state checkpointing
LANGGRAPH_STORE_BACKEND=redis            # Use Redis for cross-thread memory

# ─── Application Settings ────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development
